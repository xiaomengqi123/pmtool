[Unit]
Description=PMTool Spring Boot API
After=network.target

[Service]
Type=simple
User=pmtool
WorkingDirectory=/opt/pmtool/backend
EnvironmentFile=/etc/pmtool/pmtool.env
ExecStart=/usr/bin/java -jar /opt/pmtool/backend/pmtool.jar --spring.profiles.active=prod
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

